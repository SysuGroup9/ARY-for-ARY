generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum SubmissionStatus {
  QUEUED
  PULLED
  SCORED
  FAILED
}

enum RegistrationStatus {
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum IngestionStatus {
  NOT_CONFIGURED
  CONNECTED
  ACTIVE
  FAILED
}

enum CAType {
  CODEX
  CLAUDE_CODE
  OTHER
}

enum IngestionSource {
  CONNECTOR
  MANUAL
}

enum EvidenceType {
  SESSION_SUMMARY
  WORK
}

enum Visibility {
  PUBLIC
  PRIVATE
  INTERNAL
}

enum IntegrityStatus {
  OK
  REVIEW_NEEDED
  INTEGRITY_GAP
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
}

enum ProjectionType {
  RACE_PROGRESS
  REGISTRATION_STATUS
  COST
  RISK
  CURRENT_LEADERBOARD
  EVENT_STREAM_READ_MODEL
  SCREEN_FEED
}

enum ScreenMode {
  JUMBOTRON
  BILLBOARD
  LIVE
  LEADERBOARD
  WORKS
  ANNOUNCEMENT
}

enum ScreenFallbackMode {
  AUTO
  STABLE_PROJECTION
  STATIC_NOTICE
}

enum WorkStatus {
  DRAFT
  SUBMITTED
  LOCKED
  HIDDEN
}

enum ReportStatus {
  DRAFT
  GENERATED
  REVIEWED
  PUBLISHED
}

enum ReportType {
  RIDER_REPORT
  RACE_REPORT
  REVIEW_SUMMARY
}

enum RunnerTaskType {
  SUBMISSION_TEST
  PROGRESS_EVAL
  HARNESS_EVAL
}

enum RunnerTaskStatus {
  QUEUED
  CLAIMED
  SUCCEEDED
  FAILED
  STALE
}

enum FeedbackStatus {
  PENDING
  RESOLVED
}

enum NotificationTarget {
  ALL
  TEAM
}

enum AgentType {
  CLAUDE
  COPILOT
  DEEPSEEK
  ZHIPU
  OPENAI
  CUSTOM
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  rolesJson    String    @default("[\"RIDER\"]")
  profileName  String    @default("")
  profileOrgLabel String @default("")
  profileCompleted Boolean @default(false)
  githubAccount String?
  createdAt    DateTime  @default(now())

  organizedRaces Race[]  @relation("OrganizerRaces")
  registrations  Registration[]
  judgeAssignments JudgeAssignment[] @relation("JudgeAssignments")
  assignedJudgeAssignments JudgeAssignment[] @relation("AssignedByJudgeAssignments")
  teamMemberships TeamMember[]
  teamCaptains   Team[]  @relation("TeamCaptain")
  feedbackMessages FeedbackMessage[]
}

model Race {
  id                         String   @id @default(cuid())
  organizerId                String
  title                      String
  summary                    String
  taskPackageLabel           String
  taskDescription            String
  trainingDataSummary        String
  hasTrainingData            Boolean  @default(false)
  evaluationNotes            String
  keywordsJson               String
  tokenLimit                 Int
  signupStart                DateTime
  signupEnd                  DateTime
  raceStart                  DateTime
  raceEnd                    DateTime
  enableFreeze               Boolean  @default(false)
  freezeMinutesBeforeEnd     Int      @default(0)
  updateGranularityMinutes   Int      @default(30)
  maxTeamSize                Int      @default(5)
  submissionIntervalHours    Int      @default(24)
  cloudStudioUrl             String
  trackId                    String   @default("oval-track")
  trackConfigJson            String   @default("")
  displayShowTrainingData    Boolean  @default(false)
  displayShowOrganizerComment Boolean @default(false)
  displayShowTopHighlights   Boolean  @default(false)
  displayHighlightCount      Int      @default(3)
  displayShowRiderCode       Boolean  @default(false)
  weightTaskPassRate         Float
  weightCodeReview           Float
  weightReasoning            Float
  weightKeywords             Float
  weightTotalTask            Float
  weightTotalToken           Float
  weightTotalDialogue        Float
  harnessWeightReasoning     Float    @default(0.6)
  harnessWeightKeyword       Float    @default(0.4)
  organizerComment           String   @default("")
  status                     String?   // explicit 8-state; null=auto from time windows
  challengeSourceRefJson     String   @default("{}")
  challengeContentHash       String   @default("")
  evaluationConfigVersion    Int      @default(1)
  evaluationConfigHash       String   @default("")
  lastLeaderboardSyncAt      DateTime?
  lastShowcaseSyncAt         DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  organizer      User               @relation("OrganizerRaces", fields: [organizerId], references: [id], onDelete: Cascade)
  registrations  Registration[]
  projections    Projection[]
  awards         Award[]
  announcements  Announcement[]
  screenDisplay  ScreenDisplay?
  reports        Report[]
  teams          Team[]
  submissions    Submission[]
  teamArchives   TeamArchive[]
  feedbackThreads FeedbackThread[]
  notifications  Notification[]
  leaderboardEntries LeaderboardEntry[]
  harnessEntries  HarnessEntry[]
  highlights      RidingHighlight[]
  teamComments    TeamComment[]
  runnerTasks     RunnerTask[]
  artifacts       SubmissionArtifact[]
}

model Registration {
  id           String             @id @default(cuid())
  raceId       String
  userId       String
  status       RegistrationStatus @default(SUBMITTED)
  submittedAt  DateTime           @default(now())
  approvedAt   DateTime?
  rejectedAt   DateTime?
  withdrawnAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
 
  race         Race               @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  raceProject  RaceProject?
  evidences    Evidence[]
  work         Work?
  awards       Award[]
  reports      Report[]           @relation("SubjectReports")
  submissions  Submission[]
  artifacts    SubmissionArtifact[]
  runnerTasks  RunnerTask[]
  archives     TeamArchive[]
  feedbackThreads FeedbackThread[]
  notifications Notification[]
  leaderboardEntries LeaderboardEntry[]
  harnessEntries HarnessEntry[]
  highlights   RidingHighlight[]
  teamComments TeamComment[]
 
  @@unique([raceId, userId])
}

model RaceProject {
  id                        String          @id @default(cuid())
  registrationId            String          @unique
  githubRepoUrl             String          @default("")
  aggregateIngestionStatus  IngestionStatus @default(NOT_CONFIGURED)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  registration              Registration    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  caConnections             CAConnection[]
}

model CAConnection {
  id                   String          @id @default(cuid())
  raceProjectId        String
  caType               CAType
  ingestionSource      IngestionSource @default(MANUAL)
  connectorId          String
  connectorSecret      String          @default(cuid())
  connectorBaseUrl     String          @default("")
  connectorVersion     String          @default("")
  credentialFingerprint String         @default("")
  publicKeyPem         String          @default("")
  signatureVersion     String          @default("")
  secretVersion        Int             @default(1)
  secretRotatedAt      DateTime?
  disabledReason       String          @default("")
  caProjectId          String
  ingestionStatus      IngestionStatus @default(CONNECTED)
  registeredAt         DateTime        @default(now())
  handshakeCompletedAt DateTime?
  disabledAt           DateTime?
  lastSyncedAt         DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  raceProject          RaceProject     @relation(fields: [raceProjectId], references: [id], onDelete: Cascade)
  ingestionEvents      CAIngestionEvent[]
  sessions             Session[]

  @@index([raceProjectId, ingestionStatus])
}

model CAIngestionEvent {
  id              String          @id @default(cuid())
  caConnectionId  String
  caSessionId     String          @default("")
  messageId       String
  idempotencyKey  String          @unique
  observedAt      DateTime
  receivedAt      DateTime        @default(now())
  sequence        Int?
  payloadDigest   String          @default("")
  integrityStatus IntegrityStatus @default(OK)
  signalType      String
  signalKind      String
  payloadJson     String
  createdAt       DateTime        @default(now())

  caConnection    CAConnection    @relation(fields: [caConnectionId], references: [id], onDelete: Cascade)

  @@index([caConnectionId, observedAt])
  @@unique([caConnectionId, caSessionId, sequence])
}

model Session {
  id            String       @id @default(cuid())
  caConnectionId String
  caSessionId   String
  startedAt     DateTime
  endedAt       DateTime?
  messageCount  Int          @default(0)
  toolCallCount Int          @default(0)
  tokenCost     Int          @default(0)
  allRidingMessageLength Int  @default(0)
  lastActiveAt  DateTime?
  snapshotFetchedAt DateTime?
  currentGoal   String?
  latestActivity String?
  progressPercent Int?
  riskLevel     String?
  riskReason    String?
  taskStatus    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  caConnection  CAConnection @relation(fields: [caConnectionId], references: [id], onDelete: Cascade)

  @@unique([caConnectionId, caSessionId])
  @@index([caConnectionId, startedAt])
}

model Evidence {
  id                       String          @id @default(cuid())
  registrationId           String
  type                     EvidenceType
  title                    String
  summary                  String
  sourceRefJson            String
  sourceDigest             String          @default("")
  generatedFromEventIdsJson String         @default("[]")
  reviewFlagJson           String          @default("[]")
  integrityStatus          IntegrityStatus @default(OK)
  confidenceLevel          ConfidenceLevel @default(HIGH)
  visibility               Visibility      @default(INTERNAL)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  registration             Registration    @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, type])
}

model Projection {
  id         String         @id @default(cuid())
  raceId      String
  type        ProjectionType
  payloadJson String
  asOfAt      DateTime
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  race        Race           @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([raceId, type])
}

model SecurityAudit {
  id             String   @id @default(cuid())
  raceId         String?
  raceProjectId  String?
  registrationId String?
  userId         String?
  caConnectionId String?
  actorKind      String
  action         String
  targetType     String
  targetId       String
  result         String
  reason         String   @default("")
  payloadDigest  String   @default("")
  detailsJson    String   @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([raceId, createdAt])
  @@index([registrationId, createdAt])
  @@index([caConnectionId, createdAt])
  @@index([action, createdAt])
}

model Work {
  id             String       @id @default(cuid())
  registrationId String       @unique
  title          String
  summary        String
  demoUrl        String       @default("")
  repoUrl        String       @default("")
  videoUrl       String       @default("")
  techNotes      String       @default("")
  sourceRefJson  String       @default("{}")
  contentHash    String       @default("")
  status         WorkStatus   @default(SUBMITTED)
  visibility     Visibility   @default(PUBLIC)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  judgeAssignments JudgeAssignment[]
  awards         Award[]
}

model JudgeAssignment {
  id               String       @id @default(cuid())
  workId           String
  judgeId          String
  assignedByUserId String
  assignedAt       DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  work             Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  judge            User         @relation("JudgeAssignments", fields: [judgeId], references: [id], onDelete: Cascade)
  assignedByUser   User         @relation("AssignedByJudgeAssignments", fields: [assignedByUserId], references: [id], onDelete: Cascade)
  judgingRecord    JudgingRecord?

  @@unique([workId, judgeId])
}

model JudgingRecord {
  id                 String          @id @default(cuid())
  judgeAssignmentId  String          @unique
  scoreResultJson    String
  scoreRidingJson    String
  comments           String          @default("")
  sourceRefJson      String          @default("{}")
  sourceDigest       String          @default("")
  submittedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  judgeAssignment    JudgeAssignment @relation(fields: [judgeAssignmentId], references: [id], onDelete: Cascade)
}

model Award {
  id              String       @id @default(cuid())
  raceId           String
  registrationId   String
  workId           String?
  awardName        String
  rank             Int
  decisionReason   String      @default("")
  sourceRefJson    String      @default("{}")
  sourceDigest     String      @default("")
  publishedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  race             Race        @relation(fields: [raceId], references: [id], onDelete: Cascade)
  registration     Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  work             Work?       @relation(fields: [workId], references: [id], onDelete: SetNull)

  @@unique([raceId, awardName, rank])
}

model Report {
  id                   String       @id @default(cuid())
  raceId               String
  subjectRegistrationId String?
  type                 ReportType
  status               ReportStatus @default(DRAFT)
  title                String
  summary              String
  body                 String
  sourceRefJson        String       @default("{}")
  sourceDigest         String       @default("")
  publishedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  race                 Race         @relation(fields: [raceId], references: [id], onDelete: Cascade)
  subjectRegistration  Registration? @relation("SubjectReports", fields: [subjectRegistrationId], references: [id], onDelete: SetNull)
}

model Announcement {
  id          String     @id @default(cuid())
  raceId      String
  title       String
  body        String
  visibility  Visibility @default(PRIVATE)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  race        Race       @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([raceId, publishedAt])
  @@index([raceId, visibility, updatedAt])
}

model ScreenDisplay {
  id            String             @id @default(cuid())
  raceId        String             @unique
  mode          ScreenMode         @default(JUMBOTRON)
  theme         String             @default("default")
  fallbackMode  ScreenFallbackMode @default(AUTO)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  race          Race               @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([raceId, mode, fallbackMode])
}

model Team {
  id         String   @id @default(cuid())
  raceId      String
  captainId   String
  name        String
  createdAt   DateTime @default(now())

  race        Race      @relation(fields: [raceId], references: [id], onDelete: Cascade)
  captain     User      @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  submissions Submission[]
  archives    TeamArchive[]
  feedbackThreads FeedbackThread[]
  leaderboardEntries LeaderboardEntry[]
  harnessEntries HarnessEntry[]
  highlights  RidingHighlight[]
  comments    TeamComment[]
  runnerTasks RunnerTask[]
  artifacts   SubmissionArtifact[]

  @@unique([raceId, captainId])
}

model TeamMember {
  id          String   @id @default(cuid())
  teamId       String
  userId       String?
  displayName  String
  createdAt    DateTime @default(now())

  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Submission {
  id              String   @id @default(cuid())
  raceId           String
  teamId           String
  registrationId   String?
  status           SubmissionStatus @default(QUEUED)
  codeLabel        String
  codeContent      String?
  codeContentHash  String     @default("")
  recordLabel      String?
  ridingRecord     String?
  ridingRecordHash String     @default("")
  submitterBindingJson String @default("{}")
  tokenUsed        Int
  agentType        AgentType
  passRate         Float?
  codeReviewScore  Float?
  reasoningScore   Float?
  keywordScore     Float?
  tokenScore       Float?
  taskScore        Float?
  dialogueScore    Float?
  totalScore       Float?
  progress         Float?
  antiCheatPenalty Float?
  runnerComment    String?
  runnerStatus     String?
  createdAt        DateTime @default(now())
  pulledAt         DateTime?
  scoredAt         DateTime?
 
  race             Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  team             Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registration     Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  artifact         SubmissionArtifact?
  runnerTasks      RunnerTask[]

  @@index([registrationId, createdAt])
}

model SubmissionArtifact {
  id           String    @id @default(cuid())
  raceId       String
  teamId       String
  registrationId String?
  submissionId String    @unique
  codeLabel    String
  codeContent  String
  codeContentHash String @default("")
  recordLabel  String?
  ridingRecord String?
  ridingRecordHash String @default("")
  submitterBindingJson String @default("{}")
  tokenUsed    Int
  agentType    AgentType
  createdAt    DateTime  @default(now())
 
  race         Race      @relation(fields: [raceId], references: [id], onDelete: Cascade)
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  runnerTasks  RunnerTask[]

  @@index([registrationId, createdAt])
}

model RunnerTask {
  id            String           @id @default(cuid())
  raceId        String
  teamId        String
  registrationId String?
  submissionId  String
  artifactId    String
  taskType      RunnerTaskType
  status        RunnerTaskStatus @default(QUEUED)
  score         Float?
  runnerComment String?
  resultHash    String?
  claimedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
 
  race          Race             @relation(fields: [raceId], references: [id], onDelete: Cascade)
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registration  Registration?    @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  submission    Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  artifact      SubmissionArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
 
  @@index([raceId, status, createdAt])
  @@index([teamId, taskType, createdAt])
  @@index([registrationId, taskType, createdAt])
}

model TeamArchive {
  id              String   @id @default(cuid())
  raceId           String
  teamId           String
  registrationId   String?
  submissionId     String
  codeLabel        String
  codeContent      String
  codeContentHash  String   @default("")
  recordLabel      String?
  ridingRecord     String?
  ridingRecordHash String   @default("")
  submitterBindingJson String @default("{}")
  tokenUsed        Int
  agentType        AgentType
  taskScore        Float?
  dialogueScore    Float?
  tokenScore       Float?
  reasoningScore   Float?
  keywordScore     Float?
  totalScore       Float
  progress         Float?   @default(0)
  antiCheatPenalty Float
  createdAt        DateTime @default(now())
 
  race             Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  team             Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registration     Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
 
  @@unique([raceId, teamId])
  @@index([registrationId])
}

model FeedbackThread {
  id         String   @id @default(cuid())
  raceId      String
  teamId      String
  registrationId String?
  status      FeedbackStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
 
  race        Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  team        Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  messages    FeedbackMessage[]

  @@index([registrationId])
}

model FeedbackMessage {
  id         String   @id @default(cuid())
  threadId    String
  authorId    String
  content     String
  createdAt   DateTime @default(now())

  thread      FeedbackThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String   @id @default(cuid())
  raceId      String
  title       String
  content     String
  target      NotificationTarget
  teamId      String?
  registrationId String?
  createdAt   DateTime @default(now())
 
  race        Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([registrationId])
}

model LeaderboardEntry {
  id            String   @id @default(cuid())
  raceId         String
  teamId         String
  registrationId String?
  submissionId   String
  totalScore     Float
  progress       Float?   @default(0)
  taskScore      Float?
  tokenScore     Float?
  dialogueScore  Float?
  agentType      AgentType
  createdAt      DateTime @default(now())
 
  race           Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  team           Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
 
  @@unique([raceId, teamId])
  @@index([registrationId])
}

model HarnessEntry {
  id             String   @id @default(cuid())
  raceId          String
  teamId          String
  registrationId  String?
  harnessScore    Float
  reasoningScore  Float?
  keywordScore    Float?
  createdAt       DateTime @default(now())
 
  race            Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  team            Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registration    Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
 
  @@unique([raceId, teamId])
  @@index([registrationId])
}

model RidingHighlight {
  id          String   @id @default(cuid())
  raceId       String
  teamId       String
  registrationId String?
  score        Float
  agentType    AgentType
  excerpt      String
  codeSnippet  String
  createdAt    DateTime @default(now())
 
  race         Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  team         Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([registrationId])
}

model TeamComment {
  id          String   @id @default(cuid())
  raceId       String
  teamId       String
  registrationId String?
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
 
  race         Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  team         Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
 
  @@unique([raceId, teamId])
  @@index([registrationId])
}

model CooperationRequest {
  id               String   @id @default(cuid())
  // 提交者
  submitterId      String?
  // 企业信息
  companyName      String
  contactName      String
  contactEmail     String
  contactPhone     String   @default("")
  // 赛事基本信息
  raceTitle        String
  raceSummary      String
  taskDescription  String
  trainingDataSummary String @default("")
  evaluationNotes  String
  keywordsText     String
  // 赛程
  signupStart      String
  signupEnd        String
  raceStart        String
  raceEnd          String
  // 赛事设置
  tokenLimit              Int    @default(4000)
  maxTeamSize             Int    @default(5)
  submissionIntervalHours Int    @default(24)
  freezeMinutesBeforeEnd  Int    @default(30)
  hasTrainingData         Boolean @default(true)
  enableFreeze            Boolean @default(true)
  displayShowTrainingData      Boolean @default(true)
  displayShowOrganizerComment  Boolean @default(true)
  displayShowTopHighlights     Boolean @default(true)
  displayShowRiderCode         Boolean @default(true)
  // 文件
  taskPackageFileName String @default("")
  taskPackageFilePath String @default("")
  taskPackageFileHash String @default("")
  proposalFileName    String @default("")
  proposalFilePath    String @default("")
  proposalFileHash    String @default("")
  // 补充
  notes             String   @default("")
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}



