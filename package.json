{
  "name": "next-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:p0": "node scripts/grs004-p0-regression.mjs",
    "qa:p0": "node scripts/grs004-p0-regression.mjs",
    "db:generate": "prisma generate",
